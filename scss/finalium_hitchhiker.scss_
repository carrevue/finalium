$theme: "hitchhiker";

/// Functions \\\
@use "_functions";
/// Variables \\\
@use "_variables";

// override variables

variables.$threshold: 65%;
variables.$red: #cc181e;
variables.$white: #FCFCFC;
variables.$black: #000;
variables.$yellow: #ffbf00;
variables.$blue: #167ac6;
variables.$green: #61ad15;


variables.$primary: variables.$blue;
variables.$success: variables.$green;
variables.$warning: variables.$yellow;
variables.$danger: variables.$red;

variables.$light: #666;
variables.$dark: #333;

variables.$card-bg: #fff;
variables.$card-border: #d3d3d3;

variables.$masthead-bg: #ffffff;
variables.$masthead-border: #e8e8e8;

variables.$footer-bg: #ffffff;
variables.$footer-border: #e8e8e8;

variables.$guide-bg: #ffffff;
variables.$guide-border: #e8e8e8;

variables.$body-bg: #f1f1f1;

variables.$likesaber-gray: #cccccc;

variables.$primary: variables.$blue;
variables.$secondary: #f8f8f8;
variables.$success: variables.$green;
variables.$warning: variables.$yellow;
variables.$danger: variables.$red;

variables.$accent: #CC181E;

variables.$button-colors: (
    "primary": variables.$primary,
    "default": variables.$secondary,
    "destructive": variables.$danger,
    "dark": variables.$dark,
    "light": variables.$light,
    // "payment": $green,
);

variables.$banner-colors: (
    "error": #b91f1f,
    "warning": #f5d562, // piss yellow
    "success": variables.$primary, // blue, not green
    "info": variables.$primary, // also blue
);

/// Imports \\\
@use "_imports";