{% extends "_layout.twig" %}

{% set pin_guide = true %}
{% set flex_width_enabled = true %}

{% block head %}
<script name="feed" src="/assets/skin/finalium/feed.js?r={{ get_css_file_timestamp() }}"></script>
{% endblock %}

{% block precontent %}
    {% if skin_theme_options.finalium_display_jumbotron %}
        <div class="jumbotron">
            <div class="container {% if logged_in %}logged-in{% else %}logged-out{% endif %}">
                {% if logged_in %}
                    <div class="jumbotron-left">
                        <img class="profile-picture img-fluid" src="{{ profile_picture(user_data.id) }}" alt="{{ user_data.name }}">
                        <div>
                        <h1>{{ localize('welcome_logged_in', user_data.title) }}</h1>
                        <h3>@{{ user_data.name }}</h3>
                        <a class="button button-default" href="/my_uploads">Manage {{ icon('placeholder', 12) }}</a>
                        </div>
                    </div>
                    <div class="jumbotron-right stats">
                        <p>{{ localize('followers', user_stat_data.followers) }}
                        <br>{{ localize('views', user_stat_data.views) }}</p>
                    </div>
                {% else %}
                    <div class="jumbotron-left">
                        <h1>{{ localize('welcome_logged_out', website_branding.name) }}</h1>
                        {% if slogan %}
                            <h3><q>{{ slogan }}</q></h3>
                        {% elseif is_chaziz_sb %}
                            <h3>{{ localize('welcome_slogan') }}</h3>
                        {% endif %}
                    </div>
                    <div class="jumbotron-right">
                        <div><a class="button button-default button-big" href="/register">Get started {{ icon('placeholder', 12) }}</a></div>
                        <div>Already have an account? <a class="button button-default button-small" href="/login">{{ localize('login') }}</a></div>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% if current_theme == 'hitchhiker' %}
    {% set spinner_icon_size = 14 %}
{% else %}
    {% set spinner_icon_size = 16 %}
{% endif %}

{% block content %}
    <div class="card">
        <div id="feed">
            {% for key, shelf in feed %}
                <div class="shelf" id="shelf-{{ key }}" >
                    <div class="shelf-slider-nav" data-direction="left">
                        {{ icon(fi.spinner_left, spinner_icon_size) }}
                    </div>
                    <div class="shelf-slider-nav" data-direction="right">
                        {{ icon(fi.spinner_right, spinner_icon_size) }}
                    </div>
                    
                    <div class="shelf-header">
                        <div class="shelf-title-cell">
                            {% if shelf.icon %}<img src="{{ shelf.icon }}" class="shelf-icon profile-picture">{% endif %}
                            {% if shelf.link %}
                                <h1 class="shelf-title"><a href="{{ shelf.link }}">{{ shelf.title }}</a></h1>
                            {% else %}
                                <h1 class="shelf-title">{{ shelf.title }}</h1> 
                            {% endif %}
                            {% if shelf.author %}<span class="shelf-label">by <b><a href="/user/{{ shelf.author.username }}">{{ shelf.author.displayname }}</a></b></span>{% endif %}
                            {% if shelf.label %}<span class="shelf-label">{{ shelf.label }}</span>{% endif %}
                        </div>
                        <div class="shelf-title-cell">
                            <div class="shelf-action">
                                {% include 'components/follow_button.twig' with { 
                                    user: key,
                                    show_followers: true,
                                } %}
                            </div>
                        </div>
                    </div>
                    {% if shelf.desc %}<div class="shelf-description">{{ shelf.desc }}</div>{% endif %}
                    <div class="shelf-slider">
                        {% for upload in shelf.uploads %}
                            <div class="shelf-grid-item">
                                {% include "components/lockup.twig" with { 
                                    type: "grid",
                                } %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}