{% extends "_layout.twig" %}

{% set title = localize('notifications') %}

{% block content %}
    <div class="card card-has-padding">
        <h1>{{ localize('notifications') }}</h1>
        {% for notice in data %}
            <div class="thread">
                <div class="comment">
                    <div class="comment-avatar">
                        <img src="{{ profile_picture(notice.sender.id) }}" class="profile-picture" alt="{{ notice.sender.info.username }}" loading="lazy">
                    </div>
                    <div class="comment-body">
                        <div class="comment-header">
                            <div class="comment-author">
                                {{ notice.intro }} {{ user_link(notice.sender) }}
                            </div>
                            <div class="comment-timestamp" title="{{ notice.time | date('F j, Y') }}">
                                {{ notice.time | relative_time }}
                            </div>
                        </div>
                        <div class="comment-contents">
                            {% if notice.detail.info %}
                                {{ notice.detail.info }}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            {{ localize('no_notifications') }}
        {% endfor %}
    </div>
{% endblock %}