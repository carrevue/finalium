{% set guide_links = sidebar_main_links() %}

{% if current_theme == "hitchhiker" %}
    {% set guide_icon_size = 20 %}
{% else %}
    {% set guide_icon_size = 16 %}
{% endif %}

<div id="guide" class="{% if banner_text %}with-fullscreen-banner{% endif %}" {% if pin_guide %}style="display: block;"{% endif %}>
    <div class="guide-container">
        <ul>
            {# MAIN LINKS #}
            {% for key, item in guide_links.top %}
                <li class="guide-channel">
                    <a href="{{ item.url }}"
                    class="guide-item {% if page_name == (item.page ?? key) %}selected{% endif %}">
                        <div class="thumb">{{ icon(fi.(item.icon), guide_icon_size) }}</div>
                        {{ item.name }}
                    </a>
                </li>
            {% endfor %}
            <hr>

            {# PLAYLISTS/COLLECTIONS #}
            {% if logged_in and enable_incomplete_features %}
            <li class="header">{{ localize('library') }}</li>
                {% for key, item in sidebar_library_links() %}
                    <li class="guide-channel">
                        <a href="{{ item.url }}"
                        class="guide-item {% if page_name == (item.page ?? key) %}selected{% endif %}">
                            <div class="thumb">{{ icon(fi.(item.icon), guide_icon_size) }}</div>
                            {{ item.name }}
                        </a>
                    </li>
                {% endfor %}
            <hr>
            {% endif %}

            {# FOLLOWING/FEATURED #}
            {% if logged_in %}
                <div class="header">{{ localize('following') }}</div>
            {% else %}
                <div class="header">{{ localize('best_of_site', website_branding.name )}}</div>
            {% endif %}
            {% for item in sidebar_user_links() %}
                <li class="guide-channel">
                    <a href="/user/{{ item.username }}" class="guide-item {% if page_name == "user " ~ item.username %}selected{% endif %}">
                        <img class="thumb profile-picture" src="{{ profile_picture(item.id) }}" loading="lazy">
                        {{ item.displayname }}
                    </a>
                </li>
            {% endfor %}

            {# BOTTOM LINKS #}
            <hr>
            {% for key, item in guide_links.bottom %}
                <li class="guide-channel">
                    <a href="{{ item.url }}"
                    class="guide-item {% if page_name == (item.page ?? key) %}selected{% endif %}">
                        <div class="thumb">{{ icon(fi.(item.icon), guide_icon_size) }}</div>
                        {{ item.name }}
                    </a>
                </li>
            {% endfor %}
            
            {# LOGIN THING (hitchhiker only) #}
            {% if not logged_in and current_theme == "hitchhiker" %}
                <hr>
                <p>Sign in now to see your channels and recommendations!</p>
                <a href="/login" class="button button-primary">{{ localize('login') }}</a>
            {% endif %}
        </ul>
    </div>
</div>