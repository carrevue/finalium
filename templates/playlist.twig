<p>{{ data.description }}</p>
<div class="banner banner-warning">There is currently no functionality implemented.</div>
<div class="card results">
    {% for upload in uploads %}
        {% include "components/lockup.twig" with { 
            type: "tile",
        } %}
    {% endfor %}
</div>
{% endblock %}