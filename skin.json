{
    "metadata": {
        "id": "finalium",
        "name": "Finalium",
        "author": "Carrevue Development",
        "description": "The default FulpTube look.",
        "site": "squarebracket",
        "themes": {
            "default": {
                "name": "Light",
                "description": "The classic look of squareBracket from 2022.",
                "author": "Carrevue Development",
                "options": {
                    "finalium_display_jumbotron": true,
                    "finalium_header_upload_button_icon": true
                }
            },
            "hitchhiker": {
                "name": "Hitchhiker - 2016",
                "description": "Emulates the look of a popular video sharing site as seen around 2016.",
                "author": "Carrevue Development",
                "options": {
                    "fulptube_branding": true,
                    "finalium_use_hitchhiker_banner": true,
                    "userlink_disable_colors": true,
                    "finalium_header": {
                        "hitchhiker": true
                    },
                    "finalium_icons": {
                        "use_hitchhiker_icons": true
                    },
                    "localization": {
                        "hitchhiker_strings": true
                    },
                    "storage": {
                        "default_pfp_override": "profiledef_hitchhiker.svg",
                        "default_video_thumbnail_override": "placeholder_hitchhiker.svg",
                        "default_image_thumbnail_override": "placeholder_hitchhiker.svg"
                    }
                }
            },
            "hitchhiker_2015": {
                "name": "Hitchhiker - 2015",
                "description": "Emulates the look of a popular video sharing site as seen around 2015.",
                "author": "Carrevue Development",
                "options": {
                    "inherit": "hitchhiker",
                    "finalium_header": {
                        "hide_search_placeholder": true
                    },
                    "finalium_icons": {
                        "hitchhiker_watch_old_share_icon": true
                    }
                }
            },
            "test": {
                "name": "Test",
                "author": "Carrevue Development",
                "incomplete": true,
                "options": {
                    "fulptube_branding": true,
                    "finalium_icons": {
                        "use_hitchhiker_icons": true
                    },
                    "storage": {
                        "default_pfp_override": "profiledef_hitchhiker.svg",
                        "default_video_thumbnail_override": "placeholder_hitchhiker.svg",
                        "default_image_thumbnail_override": "placeholder_hitchhiker.svg"
                    }
                }
            }
        },
        "options": {
            "use_old_userlink": true,
            "view_use_error_page": true,
            "storage": {
                "default_pfp_override": "profiledef.png",
                "default_video_thumbnail_override": "placeholder.png",
                "default_image_thumbnail_override": "placeholder.png"
            }
        }
    }
}